<Window x:Class="ClipStitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ClipStitch" Height="820" Width="1280" MinWidth="950" MinHeight="650"
        Background="#0C1729" Foreground="#E7F1FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="{x:Type primitives:ButtonBase}">
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="#223A55"/><Setter Property="Foreground" Value="#E7F1FA"/>
            <Setter Property="BorderBrush" Value="#385570"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#355A78"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1C806B"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
        <Style x:Key="IconButton" TargetType="{x:Type primitives:ButtonBase}" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="7"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <Style x:Key="SectionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="#65FFA8"/>
        </Style>
        <Style x:Key="ControlIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type primitives:ButtonBase}}}"/>
            <Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="Background" Value="#1A3048"/><Setter Property="Foreground" Value="#E7F1FA"/><Setter Property="CaretBrush" Value="#E7F1FA"/><Setter Property="BorderBrush" Value="#496681"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#29455E"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#276455"/><Setter Property="Foreground" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <Button Content="Open folder…" Click="OpenFolder_Click" DockPanel.Dock="Left" ToolTip="Open a folder containing videos"/>
            <TextBlock x:Name="FolderLabel" Text="Choose a folder containing videos" TextTrimming="CharacterEllipsis" Margin="10,0"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock Text="VIDEOS (filename order)" FontWeight="Bold" Margin="3,0,0,8" DockPanel.Dock="Top"/>
                <ListBox x:Name="VideoList" SelectionChanged="VideoList_SelectionChanged" Background="#14263C" Foreground="White" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="3">
                                <CheckBox IsChecked="{Binding Included, Mode=TwoWay}" Click="Include_Click" DockPanel.Dock="Left" Margin="0,0,8,0"
                                          ToolTip="Include this video in selection playback and export"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="Black" MinHeight="160">
                    <vlc:VideoView x:Name="VideoView">
                        <Grid x:Name="FrameCover" Background="Black" Visibility="Collapsed">
                            <Image x:Name="FrameCoverImage" Stretch="Uniform"/>
                        </Grid>
                    </vlc:VideoView>
                </Border>
                <StackPanel Grid.Row="1">
                    <DockPanel Margin="0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Click="PlayPause_Click"
                                    ToolTip="Play from the first selection" AutomationProperties.Name="Play">
                                <Path x:Name="PlayPauseIcon" Style="{StaticResource ControlIcon}" Fill="#E7F1FA" StrokeThickness="0" Data="M 4,2 L 18,10 L 4,18 Z"/>
                            </Button>
                            <Button x:Name="StopButton" Style="{StaticResource IconButton}" Click="Stop_Click"
                                    ToolTip="Stop and return to the first selection" AutomationProperties.Name="Stop">
                                <Path Style="{StaticResource ControlIcon}" Fill="#E7F1FA" StrokeThickness="0" Data="M 3,3 L 17,3 L 17,17 L 3,17 Z"/>
                            </Button>
                            <ToggleButton x:Name="VolumeButton" Style="{StaticResource IconButton}"
                                          ToolTip="Adjust sound volume" AutomationProperties.Name="Volume">
                                <Path Style="{StaticResource ControlIcon}" Data="M 2,7 L 6,7 L 11,3 L 11,17 L 6,13 L 2,13 Z M 14,6 Q 18,10 14,14 M 17,3 Q 24,10 17,17"/>
                            </ToggleButton>
                            <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Top"
                                   IsOpen="{Binding IsChecked, ElementName=VolumeButton, Mode=TwoWay}" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#14263C" BorderBrush="#496681" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,5"
                                        PreviewKeyDown="VolumePopup_KeyDown">
                                    <StackPanel>
                                        <TextBlock Text="Volume" Margin="0,0,0,6"/>
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" Width="170" TickFrequency="5"
                                                ValueChanged="VolumeSlider_ValueChanged" ToolTip="Sound volume (0-100)" AutomationProperties.Name="Sound volume"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Border Width="1" Height="24" Background="#385570" Margin="7,0"/>
                            <Button x:Name="PreviousSectionButton" Style="{StaticResource SectionButton}" Click="PreviousSection_Click"
                                    ToolTip="Play from the previous selection" AutomationProperties.Name="Previous selection">
                                <Path Style="{StaticResource ControlIcon}" Data="M 3,2 L 3,18 M 17,3 L 7,10 L 17,17 Z"/>
                            </Button>
                            <Button x:Name="PlaySectionButton" Style="{StaticResource SectionButton}" Click="PlayClip_Click"
                                    ToolTip="Play from this selection's beginning, continuing through following selections" AutomationProperties.Name="Play selection">
                                <Path Style="{StaticResource ControlIcon}" Data="M 4,2 L 1,2 L 1,18 L 4,18 M 17,2 L 20,2 L 20,18 L 17,18 M 7,5 L 15,10 L 7,15 Z"/>
                            </Button>
                            <Button x:Name="SplitButton" Style="{StaticResource SectionButton}" Click="AddRange_Click"
                                    ToolTip="Split this selection at the playhead" AutomationProperties.Name="Split selection">
                                <Path Style="{StaticResource ControlIcon}" Data="M 8,14 L 18,2 M 8,6 L 18,18 M 8,5 A 3,3 0 1 1 2,5 A 3,3 0 1 1 8,5 M 8,15 A 3,3 0 1 1 2,15 A 3,3 0 1 1 8,15"/>
                            </Button>
                            <Button x:Name="JoinPreviousButton" Style="{StaticResource SectionButton}" Click="JoinPrevious_Click"
                                    ToolTip="Join with the previous selection, restoring the gap" AutomationProperties.Name="Join previous selection">
                                <Path Style="{StaticResource ControlIcon}" Data="M 3,2 L 3,18 M 19,4 L 13,4 L 13,10 L 6,10 M 10,6 L 6,10 L 10,14 M 13,10 L 13,16 L 19,16"/>
                            </Button>
                            <Button x:Name="JoinNextButton" Style="{StaticResource SectionButton}" Click="JoinNext_Click"
                                    ToolTip="Join with the next selection, restoring the gap" AutomationProperties.Name="Join next selection">
                                <Path Style="{StaticResource ControlIcon}" Data="M 17,2 L 17,18 M 1,4 L 7,4 L 7,10 L 14,10 M 10,6 L 14,10 L 10,14 M 7,10 L 7,16 L 1,16"/>
                            </Button>
                            <Button x:Name="NextSectionButton" Style="{StaticResource SectionButton}" Click="NextSection_Click"
                                    ToolTip="Play from the next selection" AutomationProperties.Name="Next selection">
                                <Path Style="{StaticResource ControlIcon}" Data="M 17,2 L 17,18 M 3,3 L 13,10 L 3,17 Z"/>
                            </Button>
                            <Button x:Name="RemoveSectionButton" Style="{StaticResource SectionButton}" Click="RemoveRange_Click"
                                    ToolTip="Remove this selection without moving or pausing playback (at least one selection must remain)" AutomationProperties.Name="Remove selection">
                                <Path Style="{StaticResource ControlIcon}" Data="M 2,5 L 18,5 M 7,5 L 7,2 L 13,2 L 13,5 M 4,5 L 5,18 L 15,18 L 16,5 M 8,8 L 8,15 M 12,8 L 12,15"/>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="PlaybackLabel" Text="00:00:00.000 / 00:00:00.000" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="#A7C0D3" Margin="5,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Border BorderBrush="#35516B" BorderThickness="1" CornerRadius="6" Background="#101E30" ClipToBounds="True">
                        <Grid>
                        <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      SizeChanged="TimelineScroll_SizeChanged" ScrollChanged="TimelineScroll_ScrollChanged" PreviewMouseWheel="TimelineScroll_MouseWheel"
                                      Thumb.DragStarted="TimelineScroll_DragStarted" Thumb.DragCompleted="TimelineScroll_DragCompleted">
                            <ScrollViewer.Resources>
                                <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
                                    <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style>
                                <Style x:Key="ScrollThumb" TargetType="Thumb">
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                                        <Border x:Name="ThumbSurface" Background="#4A6F92" CornerRadius="6" Margin="0,3"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#3FC48A"/></Trigger>
                                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#65FFA8"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Height" Value="20"/><Setter Property="MinHeight" Value="20"/>
                                    <Setter Property="Background" Value="#0E1B2C"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="4,2">
                                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinWidth="24"/></Track.Thumb>
                                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                                            </Track>
                                        </Border>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <Grid x:Name="Timeline" Height="108" Background="#091321" ClipToBounds="True" UseLayoutRounding="True" SnapsToDevicePixels="True" SizeChanged="Timeline_SizeChanged" MouseLeftButtonDown="Timeline_MouseDown">
                                <Canvas x:Name="Thumbnails" IsHitTestVisible="False" Margin="0,12,0,0"/>
                                <Canvas x:Name="GapOverlay" IsHitTestVisible="False" Margin="0,12,0,0"/>
                                <Canvas x:Name="RangeOverlay" Margin="0,12,0,0"/>
                                <Canvas x:Name="PlayheadOverlay" IsHitTestVisible="False"/>
                            </Grid>
                        </ScrollViewer>
                        <Grid x:Name="ThumbnailLoadingBadge" Visibility="Collapsed" Background="#B0081120" VerticalAlignment="Top"
                              Height="{Binding ActualHeight, ElementName=Timeline}"
                              MouseWheel="ThumbnailLoading_MouseWheel" Cursor="Wait">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#F00C1729" BorderBrush="#65FFA8" BorderThickness="1" CornerRadius="10" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar x:Name="ThumbnailLoadingProgress" Width="80" Height="6" IsIndeterminate="True"
                                             Foreground="#65FFA8" Background="#223A55" BorderThickness="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ThumbnailLoadingText" Text="Loading previews…" Margin="8,0,0,0" FontSize="12" Foreground="#E7F1FA"/>
                            </StackPanel>
                        </Border>
                        </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button x:Name="ExportButton" Style="{StaticResource IconButton}" Click="Export_Click" DockPanel.Dock="Right"
                            Background="#1C806B" BorderBrush="#3FC48A" ToolTip="Save kept selections as a joined MP4 video" AutomationProperties.Name="Save joined video">
                        <Path Style="{StaticResource ControlIcon}" Data="M 2,2 L 14,2 L 18,6 L 18,18 L 2,18 Z M 5,2 L 5,7 L 13,7 L 13,2 M 5,18 L 5,12 L 15,12 L 15,18"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Quality"/>
                        <ComboBox x:Name="QualityBox" Width="65" SelectedIndex="3" ToolTip="Lower numbers give higher quality and larger files" AutomationProperties.Name="Output quality">
                            <ComboBoxItem Content="18"/><ComboBoxItem Content="19"/><ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="21"/><ComboBoxItem Content="22"/><ComboBoxItem Content="23"/>
                        </ComboBox>
                        <TextBlock Text="Encoding speed" Margin="12,0,0,0"/>
                        <ComboBox x:Name="PresetBox" Width="115" SelectedIndex="2" ToolTip="Slower encoding improves compression" AutomationProperties.Name="Encoding speed">
                            <ComboBoxItem Content="veryfast"/><ComboBoxItem Content="fast"/><ComboBoxItem Content="medium"/>
                            <ComboBoxItem Content="slow"/><ComboBoxItem Content="slower"/>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="StatusLabel" Text="Ready" Foreground="#b8c2d1" TextWrapping="Wrap" Margin="3,10,0,0"/>
    </Grid>
</Window>
